# ticket-create config — copy to config.yml and fill in.
# Gitignored — your identity stays local.

# Path to the Obsidian vault root (the directory containing Anvil/).
# REQUIRED — drafts are written under {vault_path}/Anvil/Tickets/Drafts/.
# Accepts ~ (home dir) and $HOME; the skill expands them at load time.
# Examples:
#   vault_path: ~/Documents/Obsidian/Vault              # macOS / Linux (typical)
#   vault_path: $HOME/Documents/Obsidian/Vault          # same thing, explicit env var
#   vault_path: /Users/jane/Documents/Obsidian/Vault    # fully absolute (Mac)
#   vault_path: /home/jane/Documents/Obsidian/Vault     # fully absolute (Linux)
vault_path: ~/Documents/Obsidian/Vault

engineer:
  # Display name used for draft assignee/reporter when the template field is blank.
  name: ""

  # Atlassian account ID — only required at PROMOTION time (when pushing a draft
  # to Jira). Left blank, the skill resolves it on first promotion via the
  # atlassian MCP and asks you to paste it back here.
  jira_account_id: ""

  # ID of the "Assigned Engineer" custom field in your Jira (e.g. customfield_10234).
  # Left blank, the skill auto-discovers it on first promotion: it pulls a recent
  # ticket via mcp__atlassian__getJiraIssue, surfaces the candidate field IDs whose
  # name contains "engineer", asks you to confirm one, and writes it back here.
  # If you already know the ID (Jira admin → Custom Fields), set it now to skip
  # the discovery prompt.
  assigned_engineer_field_id: ""

jira:
  cloud_id: ohanafy.atlassian.net
  project_key: BMS
  browse_url: https://ohanafy.atlassian.net/browse

labels:
  # Labels the skill is allowed to INFER from a paste. The user can always force
  # any label via the --labels= flag — this list only governs auto-inference.
  allow_list:
    - bug
    - tech-debt
    - security
    - frontend
    - backend
    - ecom
    - wms
    - oms
    - rex

  # Cap on labels added by inference. User-provided --labels are uncapped.
  max_inferred: 2

links:
  # Maps the skill's logical link kinds to the literal "type" name in your Jira.
  # If your Jira uses non-default link names ("Dependency" instead of "Blocks",
  # etc.), edit the right-hand side. Most Jira Cloud installs use these defaults.
  type_map:
    blocked_by: "is blocked by"   # frontmatter blocked_by: [...] -> outward link from this issue
    blocks: "blocks"              # frontmatter blocks: [...]      -> outward link from this issue
    relates_to: "relates to"      # body "Ships With" entries      -> outward link from this issue
