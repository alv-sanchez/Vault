filters:
  and:
    - file.inFolder("Anvil/Manager")
    - file.ext == "md"
    - file.name != "_dashboard"
formulas:
  open: file.asLink(item)
  priority_rank: |
    if(priority == "CRITICAL", 0,
      if(priority == "High", 1,
        if(priority == "Medium", 2,
          if(priority == "Low", 3, 9))))
  effort_rank: |
    if(effort == "S", 0,
      if(effort == "M", 1,
        if(effort == "L", 2,
          if(effort == "XL", 3, 9))))
  verdict_rank: |
    if(recommendation == "DO NOW", 0,
      if(recommendation == "INVESTIGATE", 1,
        if(recommendation == "NEXT SPRINT", 2,
          if(recommendation == "DEFER", 3,
            if(recommendation == "WON'T DO", 4, 9)))))
properties:
  link:
    displayName: 📄 Item
  formula.open:
    displayName: 📄 Open (formula)
  item:
    displayName: Item (raw)
  priority:
    displayName: Priority
  status:
    displayName: Status
  type:
    displayName: Kind
  effort:
    displayName: LOE
  impact:
    displayName: Impact
  go_live_blocker:
    displayName: Blocker
  recommendation:
    displayName: Verdict
  source:
    displayName: Source
  ticket:
    displayName: Ticket
  date_added:
    displayName: Added
  date_completed:
    displayName: Done
  formula.priority_rank:
    displayName: P#
  formula.effort_rank:
    displayName: E#
  formula.verdict_rank:
    displayName: V#
views:
  - type: table
    name: 🔥 Fight NOW
    filters:
      and:
        - recommendation == "DO NOW"
        - status != "Completed"
    order:
      - formula.priority_rank
      - formula.effort_rank
      - item
    sort:
      - property: item
        direction: ASC
    columnSize:
      formula.priority_rank: 96
      formula.effort_rank: 77
  - type: table
    name: 🚨 Go-Live Blockers
    filters:
      and:
        - go_live_blocker == true
        - status != "Completed"
    order:
      - formula.verdict_rank
      - formula.effort_rank
      - formula.priority_rank
      - file.backlinks
    columnSize:
      formula.open: 340
      priority: 90
      status: 120
      recommendation: 110
      effort: 60
      go_live_blocker: 80
  - type: table
    name: ⏭ Next Sprint
    filters:
      and:
        - recommendation == "NEXT SPRINT"
    order:
      - formula.priority_rank
      - formula.effort_rank
      - file.basename
    columnSize:
      formula.open: 340
      priority: 90
      type: 90
      effort: 60
      status: 120
  - type: table
    name: 🔍 Investigate first
    filters:
      and:
        - recommendation == "INVESTIGATE"
    order:
      - formula.priority_rank
      - item
    columnSize:
      formula.open: 340
      priority: 90
      type: 90
      status: 120
      source: 160
  - type: table
    name: ❄ Deferred
    filters:
      and:
        - recommendation == "DEFER"
    order:
      - formula.priority_rank
      - item
    columnSize:
      formula.open: 340
      priority: 90
      type: 90
      effort: 60
      source: 160
  - type: table
    name: ✅ Completed
    filters:
      and:
        - status == "Completed"
    order:
      - formula.priority_rank
      - file.basename
    columnSize:
      formula.open: 340
      priority: 90
      type: 90
      effort: 60
      date_completed: 110
      ticket: 110
  - type: table
    name: 📚 All items
    order:
      - formula.verdict_rank
      - formula.priority_rank
      - formula.effort_rank
      - item
    columnSize:
      formula.open: 340
      priority: 90
      status: 120
      type: 90
      effort: 60
      recommendation: 110
      go_live_blocker: 80
  - type: table
    name: 🧩 By kind
    order:
      - type
      - formula.priority_rank
      - item
    columnSize:
      formula.open: 340
      type: 100
      priority: 90
      status: 120
      effort: 60
      recommendation: 110
  - type: table
    name: 📥 Intake (no verdict yet)
    filters:
      or:
        - recommendation == ""
        - recommendation == null
    order:
      - date_added
      - formula.priority_rank
    columnSize:
      formula.open: 340
      priority: 90
      type: 90
      source: 160
      date_added: 110
